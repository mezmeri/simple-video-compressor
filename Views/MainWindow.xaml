<Window
    x:Class="SimpleVideoCompressor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SimpleVideoCompressor"
    mc:Ignorable="d"
    Title="Simple Video Compressor"
    Height="350"
    Width="600"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Simple Video Compressor" />
            <TextBlock Foreground="Gray" Text="by mezmeri" />
        </StackPanel>

        <ListView 
            Grid.Row="1" 
            x:Name="VideoListView"
            AllowDrop="True" 
            Drop="VideoListView_Drop"
            Background="#F9F9F9"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            ItemsSource="{Binding VideoFiles}"
            ClipToBounds="True"
            IsManipulationEnabled="False"
            IsTextSearchEnabled="False" KeyUp="VideoListView_KeyUp_DeleteFileFromList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File name" Width="220" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding FileSizeBefore}" />
                    <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding VideoStatus}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button 
                Content="Open video folder" 
                Padding="15,8" 
                FontWeight="SemiBold"
                Background="Gray"
                Foreground="White"
                Click="Button_Click_OpenVideosFolder"/>

            <Button 
                Content="Compress all" 
                Padding="15,8" 
                FontWeight="SemiBold"
                Background="#007ACC" 
                Foreground="White" 
                Margin="10,0,0,0"
                Click="Button_CompressAll"/>

        </StackPanel>
    </Grid>
</Window>